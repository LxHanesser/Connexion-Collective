# Cloudflare Pages 响应头配置
#
# 注意：注释只能写在规则块外面。块内部的 # 行会让该块后续的头部失效。

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.connexioncollective.com https://github.com https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-src https://giscus.app; worker-src 'self' blob:; media-src 'self' https://cdn.connexioncollective.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# 带内容哈希的资源可以长期缓存；文件名变了就等于新的 URL。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 文件名固定、内容可能变的资源：一小时缓存 + 到期回源校验。
/img/*
  Cache-Control: public, max-age=3600, must-revalidate
